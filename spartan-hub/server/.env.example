# 服务端环境变量样板
# 拷贝为 .env 并填值（chmod 600）

PORT=3000
NODE_ENV=production

# SQLite 数据文件
# - 生产（Linux）：使用绝对路径，如 /var/lib/spartan/data/spartan.db
# - 开发（Windows + Git Bash）：使用相对路径 ./data/spartan.db
#   绝对路径 /j/... 在 MSYS 下会被错转为 J:\j\...，导致 DB 路径错误
SQLITE_PATH=./data/spartan.db

# JWT 签名密钥（生产必须 ≥ 64 字节随机）
JWT_SECRET=

# CORS 白名单（不带尾斜杠）
ALLOW_ORIGIN=https://spartanultra.allenboard.cn

# 代理头（部署在 Nginx 后面必须 true）
TRUSTED_PROXY=true

# 速率限制（与 Nginx 同步）
RATE_LIMIT_API=20r/s
RATE_LIMIT_LOGIN=5r/m

# Token 过期（秒）
TOKEN_TTL_SECONDS=28800
